{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wowscan",
  "version": "0.2.2",
  "identifier": "fr.axelhsn.wowscan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "wowscan",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://render.worldofwarcraft.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Prix de l'hôtel des ventes sur tous les royaumes",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMkE4NzdBNjc3QUVFNkUKUldSdTducG5lb2NxWUFwL2VacHNyK2lGSGRPdzRzZ2FOOUhSclR5dFRSWjgreUVJY0grb1A4RlUK",
      "endpoints": [
        "https://github.com/HussonAxel/wowscan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
